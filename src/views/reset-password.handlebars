<section class="auth-shell shell auth-single">
    <div class="auth-card">
        <span class="eyebrow">Seguridad</span><h1>Elegí una nueva contraseña.</h1><p class="muted">Usá al menos 6 caracteres y evitá reutilizar una contraseña importante.</p>
        <form data-reset-form data-reset-token="{{resetToken}}">
            <label>Nueva contraseña<input type="password" name="password" minlength="6" autocomplete="new-password" required></label>
            <label>Repetir contraseña<input type="password" name="confirm_password" minlength="6" autocomplete="new-password" required></label>
            <button class="button button-primary button-wide" type="submit">Actualizar contraseña</button>
            <p class="form-status" data-form-status></p>
        </form>
    </div>
</section>
